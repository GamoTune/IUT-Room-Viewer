{
  "name": "iut-room-viewer",
  "version": "4.0.0",
  "private": true,
  "workspaces": [
    "server",
    "bot",
    "web"
  ],
  "scripts": {
    "dev:server": "bun --filter server dev",
    "dev:bot": "bun --filter bot dev",
    "dev": "bun --filter '*' dev",
    "start:server": "bun --filter server start",
    "start:bot": "bun --filter bot start",
    "start": "bun --filter '*' start",
    "dev:web": "bun --filter web dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.44.1"
  }
}
