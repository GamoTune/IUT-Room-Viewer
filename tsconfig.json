// ============================================
// 📁 tsconfig.json
// Configuration TypeScript
// ============================================
{
    "compilerOptions": {
        // Cible ES2022 (moderne, compatible Node 18+)
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        // Dossiers
        "outDir": "server/dist",
        "rootDir": "server/src",
        // Mode strict (recommandé !)
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        // Compatibilité
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        // Source maps pour le debug
        "sourceMap": true
    },
    "include": [
        "server/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "server/dist"
    ]
}