# Copier en `.env.deploy` (ignoré par Git) et renseigner.
# Ces valeurs se trouvent dans l'espace client OVH :
#   Hébergements → ton hébergement → onglet « FTP - SSH ».

# Identifiant SFTP (souvent le nom de l'hébergement, parfois suffixé)
DEPLOY_USER=

# Hôte SFTP, de la forme sftp.clusterXXX.hosting.ovh.net
DEPLOY_HOST=

# Docroot de iut.gamo.one, tel que déclaré en multisite dans le panel OVH.
# Le SFTP est chrooté sur le home : pas de barre initiale.
DEPLOY_PATH=www/iut

# Le mot de passe ne se met PAS ici : lftp le demande au lancement. Pour ne pas
# le saisir à chaque fois, le placer dans ~/.netrc (chmod 600), que lftp lit.
