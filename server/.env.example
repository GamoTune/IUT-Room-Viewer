# Copier en `server/.env` (ignoré par Git) et renseigner.

# Connexion PostgreSQL.
#
#   postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:5432/iut_room_viewer
#
# Sans mot de passe si la base tourne sur la même machine et que
# l'authentification est `peer` ou `trust` — le cas d'un poste de développement.
# Un mot de passe contenant @ : / ? # doit être encodé (`%40` pour @).
DATABASE_URL="postgresql://iut_room_viewer:CHANGE_MOI@127.0.0.1:5432/iut_room_viewer"

# Journalise chaque requête SQL. À laisser vide hors diagnostic.
DB_LOGGING=""

# Répertoire des archives horodatées des documents publiés par l'IUT.
EDT_BACKUP_DIR="./data/backup"

# Racine des emplois du temps. À ne changer que si l'IUT déménage ses fichiers.
EDT_BASE_URL="https://edt-iut-info.unilim.fr/edt/"

HOST="0.0.0.0"
PORT=3010
VERSION="5.0.0"

# Protège les routes d'écriture. À remplacer par une valeur tirée au hasard :
#   openssl rand -hex 32
API_SECRET_KEY="CHANGE_MOI"
