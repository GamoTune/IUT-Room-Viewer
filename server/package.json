{
  "name": "server",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "gen:edt": "bunx prisma generate --schema=./prisma/edt/schema.prisma",
    "gen:stats": "bunx prisma generate --schema=./prisma/stats/schema.prisma",
    "generate": "bun run gen:edt && bun run gen:stats"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.2.0",
    "@prisma/client": "7.1.0",
    "@prisma/client-runtime-utils": "7.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mariadb": "^3.4.5",
    "node-cron": "^4.2.1",
    "swagger-ui-express": "^5.0.1",
    "unilim": "^2.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.7",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7.1.0",
    "typescript": "^5.9.3"
  }
}
