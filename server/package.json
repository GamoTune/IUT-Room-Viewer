{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "gen:edt": "bunx prisma generate --schema=./prisma/edt/schema.prisma",
    "gen:stats": "bunx prisma generate --schema=./prisma/stats/schema.prisma",
    "generate": "bun run gen:edt && bun run gen:stats"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "unilim": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "prisma": "^7.1.0",
    "typescript": "^5.7.2"
  }
}
