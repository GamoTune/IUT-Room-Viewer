{
  "name": "server",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "bun node_modules/typeorm/cli.js migration:generate -d src/utils/dataSource.ts",
    "db:migrate": "bun node_modules/typeorm/cli.js migration:run -d src/utils/dataSource.ts",
    "db:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/utils/dataSource.ts",
    "db:seed": "bun src/cli/seed.ts",
    "sync": "bun src/cli/sync.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.7",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.9.3"
  }
}
